{
 "team": "Sales",
 "question": "How do win rates compare across segments?",
 "steps": [
  {
   "tool": "run_sql",
   "input": {
    "query": "\nWITH opps AS (\n    SELECT\n        o.opportunity_id,\n        o.is_won,\n        o.amount,\n        a.segment\n    FROM fct_opportunities o\n    JOIN dim_accounts a ON o.account_id = a.account_id\n    WHERE o.stage IN ('Closed Won', 'Closed Lost')\n       OR o.is_won = true\n)\nSELECT\n    segment,\n    COUNT(*) AS total_opps,\n    SUM(CASE WHEN is_won THEN 1 ELSE 0 END) AS won_opps,\n    ROUND(100.0 * SUM(CASE WHEN is_won THEN 1 ELSE 0 END) / COUNT(*), 1) AS win_rate_pct,\n    ROUND(AVG(CASE WHEN is_won THEN amount END), 0) AS avg_won_deal_size,\n    ROUND(SUM(CASE WHEN is_won THEN amount ELSE 0 END), 0) AS total_won_arr\nFROM opps\nGROUP BY segment\nORDER BY win_rate_pct DESC\n"
   },
   "output": "| segment    |   total_opps |   won_opps |   win_rate_pct |   avg_won_deal_size |   total_won_arr |\n|:-----------|-------------:|-----------:|---------------:|--------------------:|----------------:|\n| Mid-Market |           48 |         21 |           43.8 |               41338 | 868100          |\n| Enterprise |           53 |         17 |           32.1 |              136900 |      2.3273e+06 |\n| SMB        |            9 |          2 |           22.2 |                4600 |   9200          |",
   "figures": []
  },
  {
   "tool": "run_python",
   "input": {
    "code": "\nimport plotly.graph_objects as go\n\nsegments = ['Mid-Market', 'Enterprise', 'SMB']\nwin_rates = [43.8, 32.1, 22.2]\ncolors = ['#2563EB', '#7C3AED', '#9CA3AF']\n\nfig = go.Figure()\n\nfig.add_trace(go.Bar(\n    x=segments,\n    y=win_rates,\n    marker_color=colors,\n    text=[f\"{w}%\" for w in win_rates],\n    textposition='outside',\n    width=0.5\n))\n\nfig.update_layout(\n    title=dict(text=\"Win Rate by Segment\", font=dict(size=20)),\n    xaxis_title=\"Segment\",\n    yaxis_title=\"Win Rate (%)\",\n    yaxis=dict(range=[0, 60]),\n    plot_bgcolor='white',\n    paper_bgcolor='white',\n    height=400,\n    showlegend=False\n)\n\nfig.update_xaxes(showgrid=False)\nfig.update_yaxes(showgrid=True, gridcolor='#E5E7EB')\n\nfig\n"
   },
